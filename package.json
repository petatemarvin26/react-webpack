{
  "name": "react-webpack",
  "version": "1.5.5",
  "description": "This boilerplate intended for react boilerplate from scratch using webpack",
  "author": "Marvin Petate",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf ./build",
    "start": "npm run clean && webpack serve --config ./config/webpack/webpack.config.js",
    "bundle": "webpack --config ./config/webpack/webpack.config.js",
    "build": "npm run clean && npm run bundle",
    "build:start": "npx serve -p 3000 ./build",
    "build:dev": "npm run clean; webpack --env variant=dev --config ./config/webpack/webpack.config.js",
    "build:uat": "npm run clean; webpack --env variant=uat --config ./config/webpack/webpack.config.js",
    "build:prod": "npm run clean; webpack --env variant=prod --config ./config/webpack/webpack.config.js"
  },
  "keywords": [
    "react",
    "react-dom",
    "webpack"
  ],
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.6",
    "@babel/preset-env": "^7.24.6",
    "@babel/preset-react": "^7.24.6",
    "@babel/preset-typescript": "^7.24.6",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.13",
    "@svgr/webpack": "^8.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^7.11.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "dotenv": "^16.4.5",
    "eslint-plugin-react": "^7.34.2",
    "eslint-webpack-plugin": "^4.2.0",
    "file-loader": "^6.2.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "react-refresh": "^0.14.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "webpack-merge": "^5.10.0"
  }
}
