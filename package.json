{
  "name": "react-webpack",
  "version": "2.0.0",
  "description": "This boilerplate intended for react project",
  "author": {
    "email": "petatemarvin26@gmail.com",
    "name": "Marvin Petate",
    "url": "https://marvin-petate.web.app"
  },
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf ./build",
    "start": "npm run clean && webpack serve --config ./config/webpack/webpack.config.js",
    "bundle": "webpack --config ./config/webpack/webpack.config.js",
    "build": "npm run clean && npm run bundle",
    "build:start": "npx serve -s -p 3000 ./build",
    "build:dev": "npm run clean; webpack --env variant=dev --config ./config/webpack/webpack.config.js",
    "build:uat": "npm run clean; webpack --env variant=uat --config ./config/webpack/webpack.config.js",
    "build:prod": "npm run clean; webpack --env variant=prod --config ./config/webpack/webpack.config.js"
  },
  "keywords": [
    "react",
    "react-dom",
    "webpack"
  ],
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@svgr/webpack": "^8.1.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.59.4",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dotenv": "^17.4.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-webpack-plugin": "^6.0.0",
    "file-loader": "^6.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "react-refresh": "^0.18.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.3",
    "webpack": "^5.107.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4",
    "webpack-merge": "^6.0.1"
  }
}
