{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./build",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "target": "esnext",
    "module": "esnext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler"
  },
  "include": [
    "*.tsx",
    "*.jsx",
    "./src/**/*",
    "./module.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}